
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="← Back"
            android:textColor="#17324D"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Travel Itinerary"
            android:textColor="#17324D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Plan every moment of your journey"
            android:textColor="#718096"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Select your trip"
            android:textColor="#17324D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerItineraryTrips"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="10dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#17324D"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR DAILY PLAN"
                    android:textColor="#B8DDE5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvItineraryTripName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Choose a destination"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActivityCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 planned activities"
                    android:textColor="#B8DDE5"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Add New Activity"
            android:textColor="#17324D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Activity title"
            android:textColor="#17324D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etActivityTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:hint="e.g. Visit the Eiffel Tower"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="#17324D"
            android:textColorHint="#8997A5"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etActivityDescription"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Description"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:textColor="#17324D"
            android:textColorHint="#8997A5"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etActivityDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="false"
            android:hint="Activity date"
            android:padding="14dp"
            android:textColor="#17324D"
            android:textColorHint="#8997A5"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etActivityTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="false"
            android:hint="Activity time"
            android:padding="14dp"
            android:textColor="#17324D"
            android:textColorHint="#8997A5"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etActivityLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Location"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="#17324D"
            android:textColorHint="#8997A5"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddActivity"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="＋  Add Activity"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="#20A6A6"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Your Activities"
            android:textColor="#17324D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/itineraryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmptyItinerary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="No activities planned yet. Add your first activity!"
            android:textColor="#8997A5"
            android:textSize="14sp"
            android:visibility="visible" />

    </LinearLayout>

</ScrollView>
